// An example user rules file. Copy it to rules.jsonc next to config.jsonc
// (or set CALLGATE_RULES_PATH) and edit it. Default, main and included
// files are checked on every tool call and reload when they change;
// /callgate status shows which files are in use, or what is wrong.
//
// Entries only say what may skip review. Everything they don't list is
// reviewed as before, and the checks in code still apply to every command:
// programs run from OMP's startup PATH, files are read only inside the
// read roots, and so on (see the top of config/default-rules.jsonc, which
// also explains option kinds and operand checks).
//
// If this file, or one it includes, has any error, no rules are used and
// every bash command is blocked in every reviewer mode until it is fixed.
// OMP reports the error and recovery; fixing the file reloads it.
{
  "$schema": "../schemas/rules.schema.json",

  // More rules files, by absolute path or ~/. config/examples/ has
  // ready-made ones, such as a kubectl policy: copy it next to this file and
  // include it.
  // "include": ["~/.omp/agent/omp-callgate/kubectl.jsonc"],

  "programs": {
    // A program the built-in rules don't know. Its own options come before
    // the subcommand, each a whole word; a subcommand not listed here, such
    // as `docker run`, is reviewed. A key with several names ("ps images")
    // lists subcommands that share one entry.
    "docker": {
      "options": { "--context": "string" },
      "subcommands": {
        "ps images": {
          "options": {
            "-a --all": "flag",
            "-q --quiet": "flag",
            "--no-trunc": "flag",
            "-f --filter": "string",
            "--format": "string"
          },
          // At most one word the shell does not expand, never opened as a
          // file: `docker images nginx`.
          "operands": { "literals": { "max": 1 } }
        },
        "logs": {
          // Not -f/--follow, which never finishes.
          "options": { "-n --tail": "string", "--since": "string", "-t --timestamps": "flag" },
          "operands": { "literals": { "min": 1, "max": 1 } }
        }
      }
    },

    // A built-in entry, changed: "extends": "default" merges into it. A key
    // set to null deletes the built-in one; it must be written exactly as in
    // config/default-rules.jsonc.
    "git": {
      "extends": "default",
      "subcommands": {
        "reflog": { "options": "any", "operands": "git-operands" },
        // Subcommands of subcommands are not entries of their own: a key
        // "worktree list" would mean two subcommands, `worktree` and `list`.
        // To allow only `git worktree list`, check the operand:
        "worktree": { "options": "any", "operands": { "literals": { "min": 1, "max": 1, "pattern": "^list$" } } },
        "stash": null
      }
    },

    // Without "extends", an entry replaces the built-in one: this cat takes
    // only -n.
    "cat": { "options": { "-n --number": "flag" }, "operands": "read-files" }
  },

  // Rules for commands the programs above don't settle. Among the rules a
  // command matches, the most restrictive decides: "block" (never runs),
  // "ask" (you decide, without the classifier; denied without a UI), then
  // "review" (handled by the session reviewer). Any of
  // them overrides the programs above, allow rules and reviewExemptTools.
  // They match the command's text, also inside loops and `sh -c '…'`, and a
  // program named by a variable (`$k delete --all`) counts as any program.
  "rules": [
    // An allow rule: this exact test runner prefix skips review. The checks
    // in code still apply (no unsafe options or files outside the read roots).
    // It trusts the project's tests to execute code. npm test instead still
    // asks under the default npm-exec rule, even with an allow prefix.
    { "id": "project-tests", "prefix": "python -m pytest", "outcome": "allow" },
    // Words: the program, then words that follow it in order. `a|b` lists
    // alternatives; `--privileged` also matches `--privileged=true`, so a
    // value needs both spellings: `--network=host` and `--network host`.
    { "id": "docker-privileged", "match": ["docker run|create --privileged|--pid", "docker run|create --network=host", "docker run|create --network host"],
      "outcome": "ask", "why": "The container could reach the host." },
    // A glob with letter classes matches any case: `prod`, `PROD`, `db-prod-1`.
    { "id": "no-prod-db", "match": "psql *[Pp][Rr][Oo][Dd]*", "outcome": "review",
      "why": "Production data." },
    // A regex, tested against the whole command as written.
    { "id": "docker-prune", "match": "/\\bdocker\\b.*\\bprune\\b/", "outcome": "block",
      "why": "Prune deletes images and volumes nobody can get back." }
  ],

  // Built-in entries to remove, by id: "program:<name>",
  // "program:<name> <subcommand>", or a built-in rule's id.
  "disable": ["program:sed", "program:git blame"]
}
