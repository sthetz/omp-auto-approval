// An example user rules file. Copy it to rules.jsonc next to config.jsonc
// (or set CLEARANCE_RULES_PATH) and edit it. It is read at session
// start and on any /clearance command; /clearance status shows
// which files are in use, or what is wrong with them.
//
// Entries only say what may skip review. Everything they don't list is
// reviewed as before, and the checks in code still apply to every command:
// programs run from OMP's startup PATH, files are read only inside the
// read roots, and so on (see the top of config/default-rules.jsonc, which
// also explains option kinds and operand checks).
//
// If this file, or one it includes, has any error, no rules are used and
// every bash command asks you first until it is fixed (denied in auto
// mode); OMP shows an error at session start.
{
  "$schema": "../schemas/rules.schema.json",

  // More rules files, by absolute path or ~/.
  // "include": ["~/.omp/agent/omp-clearance/kubectl.jsonc"],

  "programs": {
    // A program the built-in rules don't know. Its own options come before
    // the subcommand, each a whole word; a subcommand not listed here, such
    // as `kubectl delete`, is reviewed. A key with several names ("get
    // describe") lists subcommands that share one entry.
    "kubectl": {
      "options": { "--context": "string" },
      "subcommands": {
        "get describe": {
          "options": {
            "-n --namespace": "string",
            // `-o go-template-file=PATH` reads a file; like every word that
            // names a file, it must be inside the read roots.
            "-o --output": "string",
            "-l --selector": "string",
            // Not -w/--watch, which never finishes.
            "-A --all-namespaces": "flag"
          },
          // Resource names, but never secrets, in any case: their values
          // would reach the model without review.
          "operands": { "literals": { "pattern": "^(?!.*[Ss][Ee][Cc][Rr][Ee][Tt])[A-Za-z0-9.,/_-]+$" } }
        },
        "logs": {
          "options": { "-n --namespace": "string", "-c --container": "string", "--tail": "number", "--since": "string" },
          "operands": { "literals": { "min": 1, "max": 2 } }
        }
      }
    },

    // A built-in entry, changed: "extends": "default" merges into it. A key
    // set to null deletes the built-in one; it must be written exactly as in
    // config/default-rules.jsonc.
    "git": {
      "extends": "default",
      "subcommands": {
        "reflog": { "options": "any", "operands": "git-operands" },
        // Subcommands of subcommands are not entries of their own: a key
        // "worktree list" would mean two subcommands, `worktree` and `list`.
        // To allow only `git worktree list`, check the operand:
        "worktree": { "options": "any", "operands": { "literals": { "min": 1, "max": 1, "pattern": "^list$" } } },
        "stash": null
      }
    },

    // Without "extends", an entry replaces the built-in one: this cat takes
    // only -n.
    "cat": { "options": { "-n --number": "flag" }, "operands": "read-files" }
  },

  // Rules for commands the programs above don't settle. Among the rules a
  // command matches, the most restrictive decides: "block" (never runs),
  // "ask" (you decide, without the classifier; denied in auto mode), then
  // "review" (the classifier, then you, as for any reviewed command). Any of
  // them overrides the programs above, allow rules and reviewExemptTools.
  // They match the command's text, also inside loops and `sh -c '…'`, and a
  // program named by a variable (`$k delete --all`) counts as any program.
  "rules": [
    // An allow rule: a command that starts with "npm test" skips review.
    // The checks in code still apply (no options that run programs or write
    // files, no files outside the read roots), but npm runs whatever the
    // project's test script says.
    { "id": "npm-test", "prefix": "npm test", "outcome": "allow" },
    // `secret|secrets|secret/*` would miss `Secrets` and `pods,secrets`;
    // a glob with letter classes catches both.
    { "id": "kube-secrets", "match": "kubectl get|describe *[Ss][Ee][Cc][Rr][Ee][Tt]*", "outcome": "review",
      "why": "Secret values must not reach the model unreviewed." },
    // `--as` also matches `--as=admin`.
    { "id": "kube-impersonate", "match": "kubectl --as|--as-group|--token|--raw", "outcome": "review" },
    { "id": "kube-interactive", "match": "kubectl exec|port-forward|cp|edit|apply|rollout", "outcome": "ask" },
    { "id": "kube-delete-all", "match": "kubectl delete --all", "outcome": "block",
      "why": "Deleting everything is never what an agent should do on its own." }
  ],

  // Built-in entries to remove, by id: "program:<name>",
  // "program:<name> <subcommand>", or a built-in rule's id.
  "disable": ["program:sed", "program:git blame"]
}
