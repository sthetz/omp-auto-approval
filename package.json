{
  "name": "omp-clearance",
  "version": "0.5.3",
  "description": "Command rules and an AI classifier decide whether each OMP tool call runs, asks you first, or is blocked.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sthetz/omp-clearance.git"
  },
  "homepage": "https://github.com/sthetz/omp-clearance#readme",
  "bugs": {
    "url": "https://github.com/sthetz/omp-clearance/issues"
  },
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "files": [
    "index.ts",
    "src",
    "config",
    "schemas",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "smoke:omp": "node --import tsx tests/omp-smoke.ts",
    "e2e:omp": "node --import tsx tests/omp-e2e/run.ts",
    "decisions:diff": "node --import tsx tests/decision-diff/run.ts",
    "eval:classifier": "node --import tsx tests/classifier-eval/launch.ts",
    "oracle:corpus": "node --import tsx tests/shell-oracle/extract-corpus.ts",
    "oracle:shell": "node --import tsx tests/shell-oracle/run.ts",
    "oracle:programs": "node --import tsx tests/program-oracle/run.ts",
    "oracle:help": "node --import tsx tests/program-oracle/help-check.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm run test && npm run smoke:omp"
  },
  "keywords": [
    "oh-my-pi",
    "omp",
    "auto-approval",
    "command-rules",
    "permissions"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.11"
  },
  "omp": {
    "extensions": [
      "./index.ts"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-ai": "*",
    "@oh-my-pi/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@oh-my-pi/pi-ai": {
      "optional": true
    },
    "@oh-my-pi/pi-tui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^10.13.0",
    "prettier": "^3.10.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.72.0"
  }
}
