{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "omp-callgate config",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "reviewer": {
      "type": "string",
      "enum": [
        "ai",
        "manual",
        "off"
      ],
      "default": "off",
      "description": "Starting reviewer only while reviewer-state.json does not exist."
    },
    "classifierModel": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "approvalTimeoutSeconds": {
      "type": "number",
      "exclusiveMinimum": 0,
      "default": 30
    },
    "classifierTimeoutSeconds": {
      "type": "number",
      "exclusiveMinimum": 0,
      "default": 25,
      "description": "Keep below OMP's extensionHandlers.toolCallTimeoutMs (30 s by default)."
    },
    "maxConsecutiveDenials": {
      "type": "number",
      "exclusiveMinimum": 0,
      "default": 3
    },
    "readRoots": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Absolute or ~/ directories outside the workspace whose non-sensitive files read-only tools may read without review."
    },
    "reviewExemptTools": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "allow": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "deny": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "environment": {
      "type": "string",
      "default": ""
    },
    "audit": {
      "type": "boolean",
      "default": true
    }
  }
}
