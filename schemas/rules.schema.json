{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "omp-callgate command rules",
  "description": "Command rules: config/default-rules.jsonc, and a user's rules.jsonc over it. Programs, options and operands the bash fast path runs without review; see the comments at the top of config/default-rules.jsonc. src/command-rules.ts validates files more strictly than this schema can.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "programs": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_][A-Za-z0-9._+-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/program"
      }
    },
    "include": {
      "description": "User rules files only: more rules files, by absolute path or one starting with ~/.",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(/|~/)"
      }
    },
    "disable": {
      "description": "User rules files only: built-in entries to remove, by id: \"program:<name>\", \"program:<name> <subcommand>\", or a rule's id.",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(program:[A-Za-z0-9_][A-Za-z0-9._+-]*( [A-Za-z0-9][A-Za-z0-9._:-]*)?|[A-Za-z0-9][A-Za-z0-9._-]*)$"
      }
    },
    "rules": {
      "description": "Rules that send matching bash commands to review, to the user, or to a block. The most restrictive matching rule wins: block, then ask, then review.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    }
  },
  "$defs": {
    "kind": {
      "type": "string",
      "enum": [
        "flag",
        "number",
        "string",
        "read-file",
        "optional",
        "pair",
        "workspace-directory"
      ]
    },
    "options": {
      "description": "Option names to kinds. A key may list an option and its aliases, separated by spaces; \"-NUM\" accepts -20.",
      "type": "object",
      "propertyNames": {
        "pattern": "^(-NUM|(-[A-Za-z0-9]|--[A-Za-z0-9][A-Za-z0-9-]*)( +(-[A-Za-z0-9]|--[A-Za-z0-9][A-Za-z0-9-]*))*)$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/kind"
      }
    },
    "except": {
      "description": "Options never accepted: a long one also by abbreviation or extension, a short one anywhere in a group.",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(-[A-Za-z0-9]|--[A-Za-z0-9][A-Za-z0-9-]*)$"
      }
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "operandCheck": {
      "type": "string",
      "enum": [
        "read-files",
        "literals",
        "none",
        "any",
        "npm-information",
        "printf-format",
        "grep-operands",
        "diff-operands",
        "sed-script",
        "jq-filter",
        "duration-then-command",
        "git-operands",
        "git-branch-list",
        "git-tag-list",
        "git-remote",
        "git-stash-list"
      ]
    },
    "operands": {
      "oneOf": [
        {
          "$ref": "#/$defs/operandCheck"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "maxProperties": 1,
          "properties": {
            "read-files": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "min": {
                  "$ref": "#/$defs/count"
                },
                "max": {
                  "$ref": "#/$defs/count"
                }
              }
            },
            "literals": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "min": {
                  "$ref": "#/$defs/count"
                },
                "max": {
                  "$ref": "#/$defs/count"
                },
                "pattern": {
                  "type": "string",
                  "format": "regex"
                }
              }
            }
          }
        }
      ]
    },
    "entry": {
      "type": "object",
      "properties": {
        "arguments": {
          "type": "string",
          "enum": [
            "options",
            "find-expression",
            "literal-words"
          ],
          "default": "options"
        },
        "operands": {
          "$ref": "#/$defs/operands"
        },
        "stopAtOperand": {
          "type": "boolean",
          "default": false
        },
        "opensNoFiles": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "program": {
      "type": "object",
      "oneOf": [
        {
          "description": "A program without subcommands.",
          "$ref": "#/$defs/entry",
          "required": [
            "operands"
          ],
          "unevaluatedProperties": false,
          "properties": {
            "options": {
              "$ref": "#/$defs/options"
            }
          }
        },
        {
          "description": "A program with subcommands, such as git. Its options are whole words before the subcommand.",
          "required": [
            "subcommands"
          ],
          "additionalProperties": false,
          "properties": {
            "options": {
              "$ref": "#/$defs/options"
            },
            "except": {
              "$ref": "#/$defs/except"
            },
            "opensNoFiles": {
              "type": "boolean"
            },
            "subcommands": {
              "type": "object",
              "propertyNames": {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*( +[A-Za-z0-9][A-Za-z0-9._:-]*)*$"
              },
              "additionalProperties": {
                "$ref": "#/$defs/subcommand"
              }
            }
          }
        },
        {
          "description": "User rules files only: merged into the built-in entry. Option and subcommand keys are merged one by one, and null deletes a built-in one; except lists are joined; any other key replaces the built-in one.",
          "required": [
            "extends"
          ],
          "additionalProperties": false,
          "properties": {
            "extends": {
              "const": "default"
            },
            "options": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/mergedOptions"
                }
              ]
            },
            "except": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/except"
                }
              ]
            },
            "operands": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/operands"
                }
              ]
            },
            "arguments": {
              "type": [
                "string",
                "null"
              ]
            },
            "stopAtOperand": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "opensNoFiles": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "subcommands": {
              "type": "object",
              "additionalProperties": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/$defs/subcommand"
                  },
                  {
                    "$ref": "#/$defs/mergedSubcommand"
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "subcommand": {
      "$ref": "#/$defs/entry",
      "required": [
        "operands"
      ],
      "unevaluatedProperties": false,
      "properties": {
        "options": {
          "oneOf": [
            {
              "const": "any"
            },
            {
              "$ref": "#/$defs/options"
            }
          ]
        },
        "except": {
          "$ref": "#/$defs/except"
        }
      }
    },
    "mergedOptions": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "$ref": "#/$defs/kind"
          }
        ]
      }
    },
    "mergedSubcommand": {
      "description": "Merged into the built-in subcommand of that name.",
      "type": "object",
      "required": [
        "extends"
      ],
      "additionalProperties": false,
      "properties": {
        "extends": {
          "const": "default"
        },
        "options": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "const": "any"
            },
            {
              "$ref": "#/$defs/mergedOptions"
            }
          ]
        },
        "except": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/except"
            }
          ]
        },
        "operands": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/operands"
            }
          ]
        },
        "arguments": {
          "type": [
            "string",
            "null"
          ]
        },
        "stopAtOperand": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "opensNoFiles": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "rule": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "match",
            "outcome"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            "match": {
              "description": "A pattern or a list of them. \"/regex/flags\" is tested against the whole command; otherwise words: a program, then words that must follow it in order within one command. A word may list alternatives with |, use the globs * ? [...], and --name also matches --name=value; -f also matches grouped short flags such as -uf.",
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              ]
            },
            "outcome": {
              "type": "string",
              "enum": [
                "review",
                "ask",
                "block"
              ]
            },
            "why": {
              "type": "string",
              "description": "Shown in the denial, in the approval prompt, and to the classifier."
            }
          }
        },
        {
          "description": "An allow rule: a command as written that starts with \"prefix\" (exactly, followed by a space, or anything after a trailing *) may skip review. Every check in code still applies.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "prefix",
            "outcome"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            "prefix": {
              "type": "string",
              "minLength": 1
            },
            "outcome": {
              "const": "allow"
            },
            "why": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
